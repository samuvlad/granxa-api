# Copia este ficheiro a `.env` na Pi e cambia os valores.
# Xerar un JWT_SECRET:  openssl rand -hex 32

# Contrasinal do usuario Postgres (granxa)
POSTGRES_PASSWORD=change-me-strong-password

# Secret para asinar os JWTs da API
JWT_SECRET=change-me-openssl-rand-hex-32

# Orixe(s) da web para CORS (separadas por coma). A web na Pi:
CORS_ORIGINS=http://192.168.1.155:3000